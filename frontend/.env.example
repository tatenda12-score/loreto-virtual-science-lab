# ============================================================
# Virtual Science Laboratory System — Frontend Environment Variables
# ============================================================

# API base URL pointing to the FastAPI backend (including /api/v1 prefix)
# Production (Render backend):
# VITE_API_URL=https://<your-render-backend-name>.onrender.com/api/v1
#
# Development (Leave blank to use the Vite local proxy at /api/v1 or specify localhost):
VITE_API_URL=http://localhost:8000/api/v1
