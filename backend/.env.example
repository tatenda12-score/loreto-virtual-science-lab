# ============================================================
# Virtual Science Laboratory System — Backend Environment Config
# ============================================================

# Database DSN
# Production (Render / Supabase PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Development (SQLite local database):
DATABASE_URL=sqlite:///./loreto_lab.db

# JWT & Security
# Generate a strong 64-character key in production: python -c "import secrets; print(secrets.token_hex(32))"
# NOTE: Production mode (APP_ENV=production) strictly rejects default/short placeholder secrets!
SECRET_KEY=your-production-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Environment (development | production)
APP_ENV=production
APP_TITLE=Virtual Science Laboratory System
APP_VERSION=1.0.0

# CORS Allowed Origins
# Comma-separated list of allowed frontend URLs (or JSON array)
# Production Example: https://<your-project>.vercel.app
# Development Example: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://your-project.vercel.app

# Trusted Hosts
# Comma-separated list of allowed Host header values
# Production Example: localhost,127.0.0.1,<your-service>.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-service.onrender.com
